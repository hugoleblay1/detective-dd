# --- Moteur d'analyse ---
LLM_PROVIDER=anthropic          # anthropic | internal
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=              # clé du déploiement (jamais commitée)
INTERNAL_LLM_URL=               # si LLM_PROVIDER=internal (ex. endpoint Proparco)

# --- Contenu (grilles par client) ---
CONTENT_DIR=./content/proparco

# --- Base de données (docker compose) ---
DATABASE_URL=postgresql://dd:dd@localhost:5432/dd

# --- Bibliothèque interne ---
LIBRARY_ROOT=                   # racine à indexer (partage réseau, dossier local…)
